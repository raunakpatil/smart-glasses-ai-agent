# Copy to cloud.env (it isn't committed) and fill in your server. Used by deploy-cloud.sh, start-agent.cmd,
# start-agent-hidden.vbs and mission-control-cloud.cmd.
RONIE_SERVER=ubuntu@your.server.ip
RONIE_URL=wss://your-server-ip-with-dashes.sslip.io
# The "token" from your server's pairing code, so the laptop agent can connect.
RONIE_TOKEN=
